#compdef wlog

autoload -U is-at-least

_wlog() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_wlog_commands" \
"*::: :->wlog" \
&& ret=0
    case $state in
    (wlog)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:wlog-command-$line[1]:"
        case $line[1] in
            (init)
_arguments "${_arguments_options[@]}" : \
'--slug=[URL-safe slug, defaults to current directory name]:SLUG:_default' \
'--name=[Human-readable name; defaults to the slug]:NAME:_default' \
'--user=[Per-workspace handle for the current user]:USER:_default' \
'--database-url=[Postgres URL]:DATABASE_URL:_default' \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'--force[Overwrite an existing config]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
'--body=[Optional body]:BODY:_default' \
'--repo=[Originating repository slug]:REPO:_default' \
'--node-type=[Node type (intent, decomposition, execution, outcome)]:NODE_TYPE:_default' \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':title -- Task title:_default' \
&& ret=0
;;
(ls)
_arguments "${_arguments_options[@]}" : \
'--status=[Filter by status]:STATUS:_default' \
'--repo=[Filter by repository]:REPO:_default' \
'--limit=[Maximum rows]:LIMIT:_default' \
'--format=[Output format]:FORMAT:((table\:"Plain text table for human reading"
json\:"One JSON object per line"
tsv\:"Tab-separated values for spreadsheet paste"))' \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:((table\:"Plain text table for human reading"
json\:"One JSON object per line"
tsv\:"Tab-separated values for spreadsheet paste"))' \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':id -- Task identifier (full UUID or >=8 hex chars):_default' \
&& ret=0
;;
(ack)
_arguments "${_arguments_options[@]}" : \
'--reason=[Reason for rejection]:REASON:_default' \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'--edit[Open \`\$EDITOR\` to update title and body before ack]' \
'--reject[Reject the task instead of acking]' \
'-h[Print help]' \
'--help[Print help]' \
':id -- Task identifier:_default' \
&& ret=0
;;
(hooks)
_arguments "${_arguments_options[@]}" : \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_wlog__subcmd__hooks_commands" \
"*::: :->hooks" \
&& ret=0

    case $state in
    (hooks)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:wlog-hooks-command-$line[1]:"
        case $line[1] in
            (install)
_arguments "${_arguments_options[@]}" : \
'--repo=[Repository root (defaults to current working directory)]:REPO:_files' \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'--force[Overwrite hooks that wlog did not write]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(uninstall)
_arguments "${_arguments_options[@]}" : \
'--repo=[Repository root]:REPO:_files' \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--repo=[Repository root]:REPO:_files' \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(notify)
_arguments "${_arguments_options[@]}" : \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':kind -- Hook kind name (`post-commit`, `post-merge`, `pre-push`):_default' \
'*::args -- Remaining hook arguments:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_wlog__subcmd__hooks__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:wlog-hooks-help-command-$line[1]:"
        case $line[1] in
            (install)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(uninstall)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(notify)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(daemon)
_arguments "${_arguments_options[@]}" : \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_wlog__subcmd__daemon_commands" \
"*::: :->daemon" \
&& ret=0

    case $state in
    (daemon)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:wlog-daemon-command-$line[1]:"
        case $line[1] in
            (run)
_arguments "${_arguments_options[@]}" : \
'--socket=[Override the default socket path (XDG_RUNTIME_DIR/wlog.sock)]:SOCKET:_files' \
'--nats-url=[NATS URL; if unset the daemon just logs incoming payloads]:NATS_URL:_default' \
'--cc-projects-dir=[Path to \`~/.claude/projects/\` to watch. Unset disables the CC worker. Pass \`--cc-projects-dir auto\` to use the default]:CC_PROJECTS_DIR:_files' \
'--cc-cursor=[Override the CC cursor location]:CC_CURSOR:_files' \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--socket=[Override the default socket path]:SOCKET:_files' \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_wlog__subcmd__daemon__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:wlog-daemon-help-command-$line[1]:"
        case $line[1] in
            (run)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(cost)
_arguments "${_arguments_options[@]}" : \
'--days=[Number of days to summarize (inclusive of today, UTC)]:DAYS:_default' \
'--reports-dir=[Ledger root; defaults to \`<cwd>/reports/cost\`]:REPORTS_DIR:_files' \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--config=[Path to an explicit config file (overrides discovery)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Target shell:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_wlog__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:wlog-help-command-$line[1]:"
        case $line[1] in
            (init)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(ls)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(ack)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(hooks)
_arguments "${_arguments_options[@]}" : \
":: :_wlog__subcmd__help__subcmd__hooks_commands" \
"*::: :->hooks" \
