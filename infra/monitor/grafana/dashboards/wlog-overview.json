{
  "annotations": {"list": []},
  "editable": false,
  "schemaVersion": 39,
  "title": "WienerLog Overview",
  "tags": ["wlog", "overview"],
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Daemon socket payloads (5m rate)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "rate(wlog_socket_payloads_total[5m])", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CC events (5m rate)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "rate(wlog_cc_events_total[5m])", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "GH webhook events (5m rate)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "rate(wlog_gh_events_total[5m])", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "LLM USD today",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "wlog_llm_cost_usd_today", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Synthesis latency p95 (seconds)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le)(rate(wlog_synth_latency_seconds_bucket[5m])))", "refId": "p95"},
        {"expr": "histogram_quantile(0.50, sum by (le)(rate(wlog_synth_latency_seconds_bucket[5m])))", "refId": "p50"}
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Daemon logs (last hour)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "loki"},
      "targets": [{"expr": "{service=\"daemon\"} | json", "refId": "A"}]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Tasks by status",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (status)(wlog_tasks_by_status)", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Calibration MAPE (30d rolling)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "wlog_calibration_mape_30d", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    }
  ]
}
