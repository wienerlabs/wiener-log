[Unit]
Description=Ping healthchecks.io for WienerLog liveness
After=network-online.target

[Service]
Type=oneshot
User=wlog
Group=wlog
WorkingDirectory=/home/wlog/wienerlog
EnvironmentFile=/home/wlog/state/healthcheck.env
ExecStart=/home/wlog/wienerlog/scripts/healthcheck-ping.sh
TimeoutStartSec=60
