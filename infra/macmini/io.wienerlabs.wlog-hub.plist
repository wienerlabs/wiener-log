<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.wienerlabs.wlog-hub</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/wlog</string>
        <string>daemon</string>
        <string>run</string>
        <string>--nats-url</string>
        <string>nats://127.0.0.1:4222</string>
        <string>--gh-listen</string>
        <string>127.0.0.1:8787</string>
        <string>--cc-projects-dir</string>
        <string>auto</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>WLOG_DAEMON_WORKSPACE</key>
        <string>hub</string>
        <key>WLOG_GH_SECRET_FILE</key>
        <string>/Users/Shared/wlog/secrets/gh_webhook</string>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/Shared/wlog/logs/hub.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Shared/wlog/logs/hub.err.log</string>
</dict>
</plist>
