#!/usr/bin/env bash
# Pre-push: refuse to push if fmt or clippy fail. Tests run in CI.
set -euo pipefail

bold() { printf "\033[1m%s\033[0m\n" "$*"; }

bold "==> cargo fmt --check"
cargo fmt --all -- --check

bold "==> cargo clippy"
cargo clippy --workspace --all-targets -- -D warnings

bold "✓ Pre-push checks passed"
